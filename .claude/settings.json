{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/.pypirc)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.config/gcloud/application_default_credentials.json)",
      "Read(~/.config/gcloud/credentials.db)",
      "Read(~/.config/gcloud/access_tokens.db)",
      "Read(~/.config/gcloud/legacy_credentials/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(**/.pypirc)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(~/.config/gcloud/application_default_credentials.json)",
      "Edit(~/.config/gcloud/credentials.db)",
      "Edit(~/.config/gcloud/access_tokens.db)",
      "Edit(~/.config/gcloud/legacy_credentials/**)"
    ]
  }
}
